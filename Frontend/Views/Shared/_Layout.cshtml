    <script>
        var carrito = [];
           
        function TotalSC(n, precio) {
                 return (n * precio).toFixed(2);
        }

        var svg = `<svg width = "12" height = "12" viewBox = "0 0 12 12" fill = "none" xmlns = "http://www.w3.org/2000/svg" >
