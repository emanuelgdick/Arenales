                                                                   </svg>`;

           function totales(){
                 let cantProd = 0;
                 let total = 0;
                $('#idCantProd').empty();
                $('#idTotal').empty();
                 debugger;
                 carrito.forEach(function (number, index) {
                     console.log(index);
                    total = total + (carrito[index].punitario * carrito[index].cantidad);
                      cantProd++;
                  });
                $('<div>').addClass("tf-totals-total-value fw-6").text(cantProd).appendTo('#idCantProd')
                $('<div>').addClass("tf-totals-total-value fw-6").text('$'+total.toFixed(2)).appendTo('#idTotal')
              }
           function TotalQA(n, precio) {
                return (n * precio).toFixed(2);
            }
