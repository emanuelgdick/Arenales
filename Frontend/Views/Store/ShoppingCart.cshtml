            // Función para actualizar el subtotal de una fila
            function actualizarSubtotal(fila) {
                let precioUnitario = parseFloat(fila.find('.precio').text());
                let cantidad = parseInt(fila.find('.cantidad').val());
                let subtotal = precioUnitario * cantidad;
                fila.find('.subtotal').text(subtotal.toFixed(2));
            }

            // Botón "+" para sumar
            $('#tabla tbody').on('click', '.mas', function() {
                let fila = $(this).closest('tr');
                let cantidadActual = parseInt(fila.find('.cantidad').val());
                fila.find('.cantidad').val(cantidadActual + 1);
                actualizarSubtotal(fila); // Actualizar subtotal o total
                calcularTotales()
            });

            // Botón "-" para restar
            $('#tabla tbody').on('click', '.menos', function() {
                let fila = $(this).closest('tr');
                let cantidadActual = parseInt(fila.find('.cantidad').val());
                if (cantidadActual > 1) {
                    fila.find('.cantidad').val(cantidadActual - 1);
                    actualizarSubtotal(fila); // Actualizar subtotal o total
                    calcularTotales()
                }
            });

            // Botón "Eliminar"
            $('#tabla tbody').on('click', '.eliminar', function() {
                $(this).closest('tr').remove(); // Elimina la fila completa
                calcularTotales()
            });

            function calcularTotales(){
                var total = 0;
                var descuento = 0;
                $('#tabla tbody tr').each(function() {
                    var valorCelda = $(this).find('td').eq(3).text();
                    total += parseFloat(valorCelda);
                });

                $('#subTotal').text(total.toFixed(2));
                $('#descuento').text(descuento.toFixed(2));
                $('#total').text((total - descuento).toFixed(2));
            }
        });
