                           if( $("#cantidadQA").val()>1){
                           var num = parseFloat($('#precioQA').text().replace('$', '').replace(' ', '')).toFixed(2);
                           $('#totalQA').text('$'+TotalQA(parseInt($('#cantidadQA').val())-1,num));
               }
               });
               $('#btnMasQA').click(function(){

                             var num = parseFloat($('#precioQA').text().replace('$', '').replace(' ', '')).toFixed(2);
                           $('#totalQA').text('$'+TotalQA(parseInt($('#cantidadQA').val())+1,num));
               });
               $('#btnAddCarritoQA').on('click',  function (event) {

                debugger;
                var pro=carrito.find(p => p.idProducto === producto.id)
                var idpro;
                var cantidad;
                if(pro==null){
                    idpro=0;
                    cant=0;
                }
                else{
                        idpro=pro.id;
                        cant=pro.cantidad;
                }
                
                let item = {
                   id:idpro,
                   idCarrito:parseInt($('#idCarrito').text()),
                   idProducto:producto.id,
                   idProductoNavigation: null,
                   idCarritoNavigation: null,
                   precio: producto.precio,
                   cantidad: cant + parseInt($("#cantidadQA").val())
                }

                

                if(pro==null){
                    enviarProductoCarrito(item);
                    item.idProductoNavigation = { descripcion: producto.descripcion };
                    carrito.push(item);
                    $('#cantProducto').text(carrito.length);
                      $("#quick_add").modal("hide");
                }else
                {
                    item.id=pro.id;
                    //item.cantidad++;
                    let indice = carrito.findIndex(p => p.id === item.id); // Encuentra el índice del producto
                    carrito[indice].cantidad = carrito[indice].cantidad+parseInt($("#cantidadQA").val()); // Asigna el nuevo precio
                    item.idProductoNavigation = { descripcion: producto.descripcion };
                     actualizar(item);
                }
             }
