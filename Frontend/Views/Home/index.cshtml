                    $('#cantProducto').text(carrito.length);
                    $("#quick_view").modal("hide");
                } else {
                    item.id = pro.id;
                    //item.cantidad++;
                    let indice = carrito.findIndex(p => p.id === item.id); // Encuentra el índice del producto
                    carrito[indice].cantidad = carrito[indice].cantidad + parseInt($("#cantidadQV").val()); // Asigna el nuevo precio
                    item.idProductoNavigation = { descripcion: producto.descripcion };
                    actualizar(item);
                }
            }
            )
               function enviarProductoCarrito(item) {

          jQuery.ajax({
           url: '@Url.Action("AddProductoCarrito", "Carrito")?idUsuario=' +@Html.Raw(Json.Serialize(ViewBag.idUsuario)),
                    type: "POST",
                    data: JSON.stringify(item),
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                     
                       item.id=data.resultado.id;
                        $('#idCarrito').text(data.resultado.idCarrito);
                        $('#idProducto').text(data.resultado.idProducto);
                     
                      
                    }
                })


            }

