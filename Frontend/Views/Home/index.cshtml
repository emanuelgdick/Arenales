               $('#btnAddCarritoQV').on('click', function (event) {

                debugger;
                var pro = carrito.find(p => p.idProducto === producto.id)
                var idpro;
                var cantidad;
                if (pro == null) {
                    idpro = 0;
                    cant = 0;
                }
                else {
                    idpro = pro.id;
                    cant = pro.cantidad;
                }

                let item = {
                    id: idpro,
                    idCarrito: parseInt($('#idCarrito').text()),
                    idProducto: producto.id,
                    idProductoNavigation: null,
                    idCarritoNavigation: null,
                    precio: producto.precio,
                    cantidad: cant + parseInt($("#cantidadQV").val())
                }



                if (pro == null) {
                    enviarProductoCarrito(item);
                    item.idProductoNavigation = { descripcion: producto.descripcion };
